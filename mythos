#!/usr/bin/env python3
"""
Mythos CLI wrapper — works from any directory.
Just type `mythos` and the interface launches.
"""
import os
import sys
from pathlib import Path

# Find the project root (where this script lives)
_SCRIPT_DIR = Path(__file__).resolve().parent

# Set MYTHOS_ROOT so the chat launcher can find config.yaml, prompts/, etc.
os.environ["MYTHOS_ROOT"] = str(_SCRIPT_DIR)

# Make sure the project root is on sys.path so mythos_cli/, engine/, ui/ resolve
_ROOT_STR = str(_SCRIPT_DIR)
if _ROOT_STR not in sys.path:
    sys.path.insert(0, _ROOT_STR)

from mythos_cli.main import cli_main

if __name__ == "__main__":
    sys.argv[0] = sys.argv[0].removesuffix(".exe")
    sys.exit(cli_main())
