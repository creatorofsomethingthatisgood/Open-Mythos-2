"""
Mythos CLI — type `mythos` in any terminal to launch the interface.

Works just like `claude` — no arguments needed, drops you straight into chat.
"""
import os
import sys
from pathlib import Path

# The project root is wherever this script lives
_SCRIPT_DIR = Path(__file__).resolve().parent

# Set MYTHOS_ROOT so the chat launcher finds config.yaml, prompts/, etc.
os.environ.setdefault("MYTHOS_ROOT", str(_SCRIPT_DIR))

# Make sure the project root is on sys.path for engine/ and ui/ imports
_root_str = str(_SCRIPT_DIR)
if _root_str not in sys.path:
    sys.path.insert(0, _root_str)

from mythos_cli.main import cli_main

if __name__ == "__main__":
    sys.argv[0] = sys.argv[0].removesuffix(".exe")
    sys.exit(cli_main())
