#!/usr/bin/env bash
# Run Mythos without activating the venv (works on macOS and Linux).
set -e
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

if [[ -x "$ROOT/venv/bin/mythos" ]]; then
  exec "$ROOT/venv/bin/mythos" "$@"
fi

if command -v mythos >/dev/null 2>&1; then
  exec mythos "$@"
fi

echo "Mythos is not installed in this folder yet." >&2
echo "" >&2
if [[ "$(uname)" == "Darwin" ]]; then
  echo "  Run:  ./setup-macos.sh" >&2
else
  echo "  Run:  ./setup.sh" >&2
fi
echo "" >&2
echo "Then start chat with:  ./mythos" >&2
exit 1
