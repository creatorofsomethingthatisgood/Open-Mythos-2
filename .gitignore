NOTES.local
NOTES.local.*
*.local.md
*.local.txt
*.scratch
# Patch / backup artifacts that often appear during merges or edits
*.bak
*.orig
*.rej
*.patch.local
# Database / capture dumps
*.dump
*.sql.dump
*.pcap
*.har

