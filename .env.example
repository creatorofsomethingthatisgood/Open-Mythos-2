# Database Configuration
# Set these in your local .env file or GitHub Secrets for CI/CD

# Choose: sqlite, postgres
MYTHOS_DB_TYPE=sqlite
MYTHOS_DB_PATH=mythos.db

# If using PostgreSQL (e.g. in GitHub Actions or production)
# DB_HOST=your-db-host.com
# DB_USER=mythos_user
# DB_PASSWORD=your_secure_password
# DB_NAME=mythos_db
